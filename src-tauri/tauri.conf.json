{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenPace",
  "mainBinaryName": "TokenPace",
  "version": "3.1.0",
  "identifier": "io.github.fergaschas.tokenpace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "TokenPace",
    "copyright": "MIT",
    "shortDescription": "How much of your Claude plan you've used",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
